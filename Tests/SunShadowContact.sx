use GFX.Application
use GFX.Color
use GFX.ECS
use GFX.GPU
use GFX.Rendering
use GFX.Scene3D
use GFX.Scene3D.Renderer.Renderer
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func create_contact_scene(world:&ECS.World, meshes:&Scene3D.Meshes) {
    // Magnify the contact at x = 0.5 without changing the shadow-map resolution.
    let camera = Scene3D.Camera(near_plane:0.1, far_plane:10.0, vertical_fov:0.026665)
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(
            position:Math.Vec3(0.52, 3.0, 0.0),
            rotation:Math.Quat.angle_axis(Math.radians(-90.0), Math.Vec3.right())
        ))
        ..with(camera)
    )
    let cube = meshes.add(Scene3D.Geometry.Cube.make())
    let floor = meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(8.0)))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.5, 0.0)))
        ..with(Scene3D.Mesh(cube))
        ..with(Scene3D.Material())
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(rotation:Math.Quat.angle_axis(
            Math.radians(-90.0), Math.Vec3.right()
        )))
        ..with(Scene3D.Mesh(floor))
        ..with(Scene3D.Material())
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(-2.0, 4.0, 0.0)))
        ..with(Scene3D.SunLight(direction:Math.Vec3(0.5, -1.0, 0.0), intensity:3.5))
    )
}

func inspect_contact(
    device:@GPU.Device,
    surface:@GPU.Surface,
    renderer:@Renderer,
    controller:&Application.Controller
) {
    let pixels = read_scene(device, surface, renderer)
    assert(renderer.active_batch_count() == 2)
    // The cube top must be lit, so an empty or entirely dark render cannot pass.
    assert(pixels[(64 * 128 + 8) * 4] > 200 as uint8)
    let shadow = pixels[(64 * 128 + 96) * 4] as int
    assert(shadow > 20 && shadow < 120)
    // These floor pixels are immediately outside the cube, within its shadow.
    // The projected shadow must begin at the physical contact edge.
    var y = 16
    while y < 112 {
        var x = 32
        while x < 64 {
            let value = pixels[(y * 128 + x) * 4] as int
            assert(Math.abs(value - shadow) <= 3)
            x++
        }
        y++
    }
    controller.stop()
}

func check_contact() {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..width = 128
        ..height = 128
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin(Rendering.Plugin.Settings(
        antialiasing:Rendering.Antialiasing.none, presentation:false
    )))
    application.add_plugin(Scene3D.Plugin())
    application.add_system(Application.Schedule.startup, create_contact_scene)
    application.add_after_system(Application.Schedule.render, inspect_contact)
    assert(application.run() == 0)
}

func read_scene(device:@GPU.Device, surface:@GPU.Surface, renderer:@Renderer) uint8[] {
    var color = device.texture(GPU.TextureSettings(
        format:surface.format(), width:128, height:128,
        usage:GPU.TextureUsage(color_target:true)
    ))
    var depth = device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.depth16, width:128, height:128,
        usage:GPU.TextureUsage(depth_stencil_target:true)
    ))
    var download = device.download_buffer(128 * 128 * 4)
    var commands = device.commands()
    var colors:GPU.ColorTarget[] = [GPU.ColorTarget(texture:color, clear:Color.black())]
    var pass = commands.render(colors, GPU.DepthTarget(texture:depth))
    pass.viewport(0.0, 0.0, 128.0, 128.0)
    pass.scissor(0, 0, 128, 128)
    renderer.draw(pass)
    pass.finish()
    var transfer = commands.copy()
    transfer.download(GPU.TextureRegion(texture:color, width:128, height:128), download, 128, 128)
    transfer.finish()
    var completed = commands.submit_and_track()
    completed.wait()
    return download.read()
}

struct SunSurfaceProbe {
    var reference:uint8[] = []
    var frame:int = 0
}

func create_lit_surface(world:&ECS.World, meshes:&Scene3D.Meshes) {
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(
            position:Math.Vec3(0.0, 6.0, 12.0),
            rotation:Math.Quat.angle_axis(Math.radians(-28.0), Math.Vec3.right())
        ))
        ..with(Scene3D.Camera(near_plane:0.05, far_plane:1000.0, vertical_fov:Math.radians(70.0)))
    )
    world.spawn(ECS.EntityRecipe() ..with(Scene3D.AmbientLight(intensity:0.2)))
    // A wide, thin box exposes both the top and the grazing front face.
    let floor = meshes.add(Scene3D.Geometry.Cube.make(Math.Vec3(15.0, 0.3, 10.0)))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform())
        ..with(Scene3D.Mesh(floor, casts_shadows:false))
        ..with(Scene3D.Material(albedo:Color.bytes(72, 89, 103), roughness:0.65))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.18, 0.0)))
        ..with(Scene3D.SunLight(direction:Math.Vec3(-0.45, -1.0, -0.3), intensity:3.5))
    )
}

func inspect_lit_surface(
    device:@GPU.Device,
    surface:@GPU.Surface,
    renderer:@Renderer,
    world:&ECS.World,
    probe:&SunSurfaceProbe,
    controller:&Application.Controller
) {
    let pixels = read_scene(device, surface, renderer)
    if probe.frame == 0 {
        assert(pixels.count() == 128 * 128 * 4)
        assert(pixels[(64 * 128 + 64) * 4] > 40 as uint8)
        probe.reference = pixels
        for entity in world.entities() {
            if world.has<Scene3D.Mesh>(entity) {
                world.update<Scene3D.Mesh>(entity, func(mesh:&Scene3D.Mesh) {
                    mesh.casts_shadows = true
                })
            }
        }
        probe.frame++
        return
    }
    var differences = 0
    var worst = 0.0
    var index = 0
    while index < pixels.count() {
        let difference = Math.abs((pixels[index] as int) - (probe.reference[index] as int))
        if difference > 3 { differences++ }
        worst = Math.max(worst, difference)
        index++
    }
    if differences > 0 {
        print("sun-lit surface: $(differences) changed channels, largest error $(worst)")
    }
    assert(differences == 0)
    if probe.frame == 1 {
        for entity in world.entities() {
            if world.has<Scene3D.SunLight>(entity) {
                world.update<Scene3D.SunLight>(entity, func(light:&Scene3D.SunLight) {
                    light.shadow.softness = 0.75
                })
            }
        }
        probe.frame++
        return
    }
    controller.stop()
}

func check_surface() {
    var application = Application()
    application.add_resource(SunSurfaceProbe())
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..width = 128
        ..height = 128
        ..hidden = true
    ))
    application.add_plugin(Rendering.Plugin(Rendering.Plugin.Settings(
        antialiasing:Rendering.Antialiasing.none, presentation:false
    )))
    application.add_plugin(Scene3D.Plugin())
    application.add_system(Application.Schedule.startup, create_lit_surface)
    application.add_after_system(Application.Schedule.render, inspect_lit_surface)
    assert(application.run() == 0)
}

test "keep sun shadows attached to a cube resting on a plane" { check_contact() }
test "keep sun-lit box faces free of self shadows" { check_surface() }

// Also exercise the optimized native pipeline, which formerly distorted the
// cascade width and introduced diagonal bands even on a lone convex box.
func main() {
    check_contact()
    check_surface()
    print("Sun shadows: contact edge and unoccluded faces verified")
}
