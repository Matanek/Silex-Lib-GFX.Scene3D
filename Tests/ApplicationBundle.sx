use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Scene2D
use GFX.Scene3D
use GFX.Scene3D.Renderer
use GFX.Window.Plugin as WindowPlugin
use STD.Math

struct SceneNumber { let value:int }
struct LocalContent { let scene:int }

class Probe {
    var starts:int
    var finalizes:int
    var observed:int[]
    var batch_allocations:int[]

    init() {
        self.starts = 0
        self.finalizes = 0
        self.observed = []
        self.batch_allocations = []
    }
}

func create_content(
    number:@SceneNumber,
    world:&ECS.World,
    meshes:&Scene3D.Meshes,
    probe:&Probe
) {
    probe.starts++

    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(4.0), 3.0),
            Canvas.Fill.solid(Color.amber_400())
        )
    })
    world.spawn(ECS.EntityRecipe()
        ..with(LocalContent(scene:number.value))
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(drawing, 8, 8))
    )

    let cube = meshes.add(Scene3D.Geometry.Cube.make())
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.0, 6.0)))
        ..with(Scene3D.Camera())
    )
    world.spawn(ECS.EntityRecipe()
        ..with(LocalContent(scene:number.value))
        ..with(Scene3D.Transform())
        ..with(Scene3D.Mesh(cube))
        ..with(Scene3D.Material(albedo:Color.slate_400()))
    )
}

func finalize_content(probe:&Probe) {
    probe.finalizes++
}

func inspect_content(
    number:@SceneNumber,
    canvases:ECS.Query<(@LocalContent, @Scene2D.Canvas)>,
    mesh_entities:ECS.Query<(@LocalContent, @Scene3D.Mesh)>,
    renderer:@Renderer,
    bundles:&Application.BundleManager,
    probe:&Probe,
    controller:&Application.Controller
) {
    var canvas_count = 0
    for (marker, canvas) in canvases {
        assert(marker.scene == number.value)
        assert(canvas.width() == 8)
        canvas_count++
    }
    var mesh_count = 0
    for (marker, mesh) in mesh_entities {
        assert(marker.scene == number.value)
        assert(mesh.asset.is_valid())
        mesh_count++
    }
    assert(canvas_count == 1)
    assert(mesh_count == 1)
    assert(renderer.active_batch_count() == 1)
    probe.batch_allocations.append(renderer.batch_allocation_count())
    probe.observed.append(number.value)

    if number.value == 1 {
        bundles.replace(bundles.create()
            ..add_resource(SceneNumber(value:2))
            ..add_system(Application.Schedule.startup, create_content)
            ..add_after_system(Application.Schedule.render, inspect_content)
            ..add_system(Application.Schedule.finalize, finalize_content)
        )
    } else {
        controller.stop()
    }
}

test "isolate successive scenes that compose 2D and 3D content" {
    var application = Application()
    var probe = Probe()
    var initial = Application.Bundle(application)
        ..add_resource(SceneNumber(value:1))
        ..add_system(Application.Schedule.startup, create_content)
        ..add_after_system(Application.Schedule.render, inspect_content)
        ..add_system(Application.Schedule.finalize, finalize_content)

    application
        ..add_resource(probe)
        ..add_plugin(WindowPlugin(WindowPlugin.Settings()
            ..title = "Scene2D and Scene3D application scenes"
            ..width = 32
            ..height = 32
            ..hidden = true
        ))
        ..add_plugin(Scene2D.Plugin())
        ..add_plugin(Scene3D.Plugin())
        ..add_plugin(Application.BundleManager(initial))

    assert(application.run() == 0)
    assert(probe.starts == 2)
    assert(probe.finalizes == 2)
    assert(probe.observed.count() == 2)
    assert(probe.observed[0] == 1)
    assert(probe.observed[1] == 2)
    assert(probe.batch_allocations.count() == 2)
    assert(probe.batch_allocations[0] == 1)
    assert(probe.batch_allocations[1] == 1)
}
