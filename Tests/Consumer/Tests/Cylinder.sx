use GFX.Scene3D
use STD.Math

test "cylinder has outward triangles sharp caps continuous side seam and bounded UVs" {
    for count in [3,8,24] {
        let mesh=Scene3D.Geometry.Cylinder.make(0.3,0.2,count)
        let vertices=mesh.vertices();let indices=mesh.indices()
        assert(mesh.vertex_count()==4*count+6 && mesh.triangle_count()==4*count)
        for v in vertices {
            assert(Math.abs(v.normal.length()-1.0)<0.00001)
            assert(Math.abs(v.position.y)<=0.100001 && v.position.x*v.position.x+v.position.z*v.position.z<=0.090001)
            assert(v.uv.x>=0.0 && v.uv.x<=1.0 && v.uv.y>=0.0 && v.uv.y<=1.0)
        }
        var i=0
        while i<indices.count() {
            let a=vertices[indices[i] as int];let b=vertices[indices[i+1] as int];let c=vertices[indices[i+2] as int]
            assert(b.position.subtract(a.position).cross(c.position.subtract(a.position)).dot(a.normal)>0.00001)
            i+=3
        }
        assert(vertices[0].position==vertices[2*count].position && vertices[1].position==vertices[2*count+1].position)
        assert(vertices[0].uv.x==0.0 && vertices[2*count].uv.x==1.0)
        assert(vertices[0].normal.y==0.0 && vertices[2*(count+1)].normal==Math.Vec3.down())
        assert(vertices[3*count+4].normal==Math.Vec3.up())
    }
}
test "default cylinder is centered on local Y with the requested dimensions" {
    let mesh=Scene3D.Geometry.Cylinder.make()
    assert(mesh.vertex_count()==102 && mesh.triangle_count()==96)
    var minimum=Math.Vec3(100.0);var maximum=Math.Vec3(-100.0)
    for v in mesh.vertices() {
        minimum=Math.Vec3(Math.min(minimum.x,v.position.x),Math.min(minimum.y,v.position.y),Math.min(minimum.z,v.position.z))
        maximum=Math.Vec3(Math.max(maximum.x,v.position.x),Math.max(maximum.y,v.position.y),Math.max(maximum.z,v.position.z))
    }
    assert(minimum.nearly_equal(Math.Vec3(-0.5),0.00001) && maximum.nearly_equal(Math.Vec3(0.5),0.00001))
}
