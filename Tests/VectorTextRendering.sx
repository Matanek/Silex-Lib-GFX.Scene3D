use GFX.Application
use GFX.Color
use GFX.ECS
use GFX.Font
use GFX.Scene3D
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func render_face(result:Result<Font.Face, Font.Error>) Font.Face {
    match result {
        failure(error) => { panic(error.detail) }
        success(face) => { return face }
    }
}

func render_instance(result:Result<Font.Instance, Font.Error>) Font.Instance {
    match result {
        failure(error) => { panic(error.detail) }
        success(instance) => { return instance }
    }
}

func render_run(result:Result<Font.GlyphRun, Font.Error>) Font.GlyphRun {
    match result {
        failure(error) => { panic(error.detail) }
        success(run) => { return run }
    }
}

func render_text(result:Result<Scene3D.MeshHandle, Scene3D.TextError>) Scene3D.MeshHandle {
    match result {
        failure(error) => { panic(error.detail) }
        success(handle) => { return handle }
    }
}

func create_shadowed_text(world:&ECS.World, meshes:&Scene3D.Meshes) {
    var face = render_face((try Font.Face.decode(embed_bytes("../../GFX.Font/Tests/Fixtures/Minimal.ttf"))))
    var instance = render_instance((try Font.Instance.create(face, size:1.0)))
    var run = render_run((try instance.shape("OBé")))
    let text = render_text((try meshes.add_text(Scene3D.Text(
        run,
        plane:Scene3D.TextPlane(
            origin:Math.Vec3(-1.0, 0.0, 0.0),
            x_axis:Math.Vec3.right(),
            y_axis:Math.Vec3.up()
        )
    ))))
    let receiver = meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(4.0, 2.0)))
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.6, 4.0)))
        ..with(Scene3D.Camera(near_plane:0.05, far_plane:20.0))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform())
        ..with(Scene3D.Mesh(text, casts_shadows:true))
        ..with(Scene3D.Material(albedo:Color.amber_400(), roughness:0.5))
        ..with(Scene3D.MaterialSettings(
            alpha:Scene3D.AlphaMode.mask,
            double_sided:true
        ))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.Transform(position:Math.Vec3(0.0, 0.0, -0.4)))
        ..with(Scene3D.Mesh(receiver, casts_shadows:false))
        ..with(Scene3D.Material(albedo:Color.slate_700(), roughness:0.9))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Scene3D.SunLight(
            direction:Math.Vec3(0.2, -0.2, -1.0).normalized(),
            intensity:3.0
        ))
    )
}

func stop_after_vector_text_render(controller:&Application.Controller) {
    controller.stop()
}

test "render planar glyph holes through ordinary PBR and shadow passes" {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "Scene3D vector text integration"
        ..width = 96
        ..height = 64
        ..hidden = true
    ))
    application.add_plugin(Scene3D.Plugin())
    application.add_system(Application.Schedule.startup, create_shadowed_text)
    application.add_after_system(
        Application.Schedule.render,
        stop_after_vector_text_render
    )
    assert(application.run() == 0)
}
