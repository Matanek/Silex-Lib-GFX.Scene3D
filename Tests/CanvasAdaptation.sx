use GFX.Canvas
use GFX.Color
use GFX.Scene3D
use STD.Math

func required_canvas_geometry(
    result:Result<Scene3D.MeshHandle, Scene3D.CanvasGeometryError>
) Scene3D.MeshHandle {
    match result {
        failure(error) => { panic(error.detail) }
        success(handle) => { return handle }
    }
}

func required_canvas_text(
    result:Result<Scene3D.MeshHandle, Scene3D.TextError>
) Scene3D.MeshHandle {
    match result {
        failure(error) => { panic(error.detail) }
        success(handle) => { return handle }
    }
}

func mapping() Scene3D.PlaneMapping {
    return Scene3D.PlaneMapping(
        origin:Math.Vec3(1.0, 2.0, 3.0),
        x_axis:Math.Vec3(0.1, 0.0, 0.0),
        y_axis:Math.Vec3(0.0, 0.2, 0.0)
    )
}

func assert_winding_matches_normals(mesh:Scene3D.Geometry.Mesh) {
    let vertices = mesh.vertices()
    let indices = mesh.indices()
    var index = 0
    var faces = 0
    while index < indices.count() {
        let first = vertices[indices[index] as int]
        let second = vertices[indices[index + 1] as int]
        let third = vertices[indices[index + 2] as int]
        let face = second.position.subtract(first.position)
            .cross(third.position.subtract(first.position))
        if face.length_squared() > 0.000000000001 {
            assert(face.dot(first.normal) > 0.0)
            faces++
        }
        index += 3
    }
    assert(faces > 0)
}

test "convert analytic Canvas silhouettes into physical planar geometry" {
    var drawing = Canvas.Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(20.0, 15.0), 9.0),
            Canvas.Fill.with_brush(Canvas.Brush.linear(
                Math.Vec2(11.0, 15.0),
                Math.Vec2(29.0, 15.0),
                Color.cyan_300(),
                Color.blue_600()
            ))
        )
        painter.stroke(
            Canvas.Rect(Math.Vec2(36.0, 8.0), Math.Vec2(20.0, 16.0), 4.0),
            Canvas.Stroke(Color.amber_400(), 3.0)
        )
    })
    var meshes = Scene3D.Meshes()
    let frame = Canvas.Rect(Math.Vec2(), Math.Vec2(64.0, 32.0))
    var snapshot = drawing.snapshot(64, 32)
    let handle = required_canvas_geometry(meshes.add_canvas_geometry(
        snapshot, frame, mapping()
    ))
    let mesh = meshes.snapshot(handle)

    // A raw Canvas analytic circle would be two triangles. Scene3D receives
    // an actual curved silhouette suitable for color and shadow passes.
    assert(mesh.triangle_count() > 100)
    var minimum = mesh.vertices()[0].position
    var maximum = minimum
    for vertex in mesh.vertices() {
        assert(vertex.position.z == 3.0)
        assert(vertex.normal.nearly_equal(Math.Vec3.back(), 0.00001))
        let logical_x = (vertex.position.x - 1.0) / 0.1
        let logical_y = (vertex.position.y - 2.0) / 0.2
        assert(Math.abs(vertex.uv.x - logical_x / 64.0) < 0.0001)
        assert(Math.abs(vertex.uv.y - logical_y / 32.0) < 0.0001)
        minimum = minimum.minimum(vertex.position)
        maximum = maximum.maximum(vertex.position)
    }
    assert(minimum.x < maximum.x)
    assert(minimum.y < maximum.y)
    assert(minimum.z == maximum.z)
    assert_winding_matches_normals(mesh)
}

test "reuse the Scene3D text contour path inside Canvas geometry" {
    var drawing = Canvas.Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "BO",
            Math.Vec2(8.0, 4.0),
            Canvas.TextStyle(size:18.0, color:Color.rose_400())
        )
    })
    var snapshot = drawing.snapshot(64, 32)
    var layers = snapshot.text_layers()
    var meshes = Scene3D.Meshes()
    let converted = required_canvas_geometry(meshes.add_canvas_geometry(
        snapshot,
        Canvas.Rect(Math.Vec2(), Math.Vec2(64.0, 32.0)),
        mapping()
    ))
    let direct = required_canvas_text(meshes.add_canvas_text(
        layers[0],
        Scene3D.TextPlane(
            origin:mapping().origin,
            x_axis:mapping().x_axis,
            y_axis:mapping().y_axis
        )
    ))
    let converted_mesh = meshes.snapshot(converted)
    let direct_mesh = meshes.snapshot(direct)
    assert(converted_mesh.vertex_count() == direct_mesh.vertex_count())
    assert(converted_mesh.index_count() == direct_mesh.index_count())
    var minimum_y = 32.0
    var maximum_y = 0.0
    var index = 0
    while index < converted_mesh.vertex_count() {
        let vertex = converted_mesh.vertices()[index]
        assert(vertex.position.nearly_equal(
            direct_mesh.vertices()[index].position,
            0.00001
        ))
        let logical_x = (vertex.position.x - 1.0) / 0.1
        let logical_y = (vertex.position.y - 2.0) / 0.2
        minimum_y = Math.min(minimum_y, logical_y)
        maximum_y = Math.max(maximum_y, logical_y)
        assert(vertex.color == Color.rose_400())
        assert(direct_mesh.vertices()[index].color == Color.rose_400())
        assert(Math.abs(vertex.uv.x - logical_x / 64.0) < 0.0001)
        assert(Math.abs(vertex.uv.y - logical_y / 32.0) < 0.0001)
        index++
    }
    assert(minimum_y >= 3.0)
    assert(maximum_y < 28.0)
    assert_winding_matches_normals(converted_mesh)
    assert_winding_matches_normals(direct_mesh)
}

test "reject raster-only Canvas commands and degenerate mappings explicitly" {
    var filtered = Canvas.Canvas()
    filtered.paint(func(painter:&Canvas.Painter) {
        painter.layer([Canvas.Effect.blur(3.0)], func(layer:&Canvas.Painter) {
            layer.fill(
                Canvas.Circle(Math.Vec2(12.0), 8.0),
                Canvas.Fill.solid(Color.white())
            )
        })
    })
    var meshes = Scene3D.Meshes()
    var snapshot = filtered.snapshot(32, 32)
    match meshes.add_canvas_geometry(
        snapshot,
        Canvas.Rect(Math.Vec2(), Math.Vec2(32.0)),
        mapping()
    ) {
        success(handle) => { panic("expected raster-only Canvas rejection") }
        failure(error) => {
            assert(error.detail ==
                "Scene3D Canvas geometry rejects image fills and raster effects; use CanvasPanel")
        }
    }

    var vector = Canvas.Canvas()
    vector.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(8.0)),
            Canvas.Fill.solid(Color.white())
        )
    })
    var vector_snapshot = vector.snapshot(8, 8)
    match meshes.add_canvas_geometry(
        vector_snapshot,
        Canvas.Rect(Math.Vec2(), Math.Vec2(8.0)),
        Scene3D.PlaneMapping(
            origin:Math.Vec3(),
            x_axis:Math.Vec3.right(),
            y_axis:Math.Vec3.right()
        )
    ) {
        success(handle) => { panic("expected degenerate mapping rejection") }
        failure(error) => {
            assert(error.detail ==
                "Scene3D Canvas geometry plane axes must be non-zero and non-collinear")
        }
    }
}
