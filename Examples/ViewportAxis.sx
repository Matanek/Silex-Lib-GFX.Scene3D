use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math

func create_scene(world:&Resources.World, meshes:&Resources.Meshes3D) {
    let cube = meshes.add(Scene3D.Geometry.Cube.make(Math.Vec3(1.5)))
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(position:Math.Vec3(0.0, 0.75, 0.0)))
        ..with(Components.Mesh3D(cube))
        ..with(Components.Material3D(
            albedo:Color.orange_400(),
            metallic:0.08,
            roughness:0.42
        ))
    )
}

func main() {
    Application()
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Scene3D — Viewport axis"
            ..width = 960
            ..height = 640
        ))
        ..add_plugin(Plugins.Rendering(Plugins.Rendering.Settings()
            ..clear = Color.slate_900()
        ))
        ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.Grid3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings()
            ..distance = 9.0
            ..min_distance = 2.0
            ..max_distance = 20.0
            ..yaw = Math.radians(35.0)
            ..pitch = Math.radians(-28.0)
        ))
        ..add_plugin(Plugins.ViewportAxis3D())
        ..add_plugin(Plugins.ViewportAxisController3D())
        ..add_system(Application.Schedule.startup, create_scene)
        ..run()
}
