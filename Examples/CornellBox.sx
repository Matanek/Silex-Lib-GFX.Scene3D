use GFX.Application
use GFX.Color
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math

func add_mesh(
    world:&Resources.World,
    mesh:Scene3D.MeshHandle,
    material:Components.Material3D,
    position:Math.Vec3,
    rotation:Math.Quat = Math.Quat(),
    scale:Math.Vec3 = Math.Vec3(1.0)
) {
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(position:position, rotation:rotation, scale:scale))
        ..with(Components.Mesh3D(mesh))
        ..with(material)
    )
}

func create_box(world:&Resources.World, meshes:&Resources.Meshes3D) {
    let room_size = 4.0
    let half = room_size * 0.5
    let light_size = room_size * 0.25
    let strip_size = (room_size - light_size) * 0.5
    let strip_offset = light_size * 0.5 + strip_size * 0.5
    let half_turn = Math.radians(180.0)
    let quarter_turn = Math.radians(90.0)

    let white = Components.Material3D(
        albedo:Color.bytes(218, 212, 194),
        roughness:0.9
    )
    let red = Components.Material3D(
        albedo:Color.bytes(190, 48, 42),
        roughness:0.85
    )
    let green = Components.Material3D(
        albedo:Color.bytes(52, 168, 70),
        roughness:0.85
    )
    let metal = Components.Material3D(
        albedo:Color.bytes(220, 216, 198),
        metallic:1.0,
        roughness:0.32
    )
    let dielectric = Components.Material3D(
        albedo:Color.bytes(220, 216, 198),
        roughness:0.08
    )
    let emitter = Components.Material3D(
        albedo:Color.bytes(255, 244, 214),
        roughness:1.0,
        emission:Color.bytes(255, 244, 214),
        emission_intensity:6.0
    )

    let wall = meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(room_size)))
    let ceiling_side = meshes.add(Scene3D.Geometry.Plane.make(
        Math.Vec2(strip_size, room_size)
    ))
    let ceiling_center = meshes.add(Scene3D.Geometry.Plane.make(
        Math.Vec2(light_size, strip_size)
    ))
    let light = meshes.add(Scene3D.Geometry.Plane.make(Math.Vec2(light_size)))
    let cube = meshes.add(Scene3D.Geometry.Cube.make())

    let left = Math.Quat.angle_axis(quarter_turn, Math.Vec3.up())
    let right = Math.Quat.angle_axis(-quarter_turn, Math.Vec3.up())
    let back = Math.Quat.angle_axis(half_turn, Math.Vec3.up())
    let up = Math.Quat.angle_axis(-quarter_turn, Math.Vec3.right())
    let down = Math.Quat.angle_axis(quarter_turn, Math.Vec3.right())

    add_mesh(world, wall, white, Math.Vec3(0.0, 0.0, -half))
    add_mesh(world, wall, white, Math.Vec3(0.0, 0.0, half), back)
    add_mesh(world, wall, white, Math.Vec3(0.0, -half, 0.0), up)
    add_mesh(world, wall, red, Math.Vec3(-half, 0.0, 0.0), left)
    add_mesh(world, wall, green, Math.Vec3(half, 0.0, 0.0), right)

    add_mesh(world, ceiling_side, white, Math.Vec3(-strip_offset, half, 0.0), down)
    add_mesh(world, ceiling_side, white, Math.Vec3(strip_offset, half, 0.0), down)
    add_mesh(world, ceiling_center, white, Math.Vec3(0.0, half, -strip_offset), down)
    add_mesh(world, ceiling_center, white, Math.Vec3(0.0, half, strip_offset), down)
    add_mesh(world, light, emitter, Math.Vec3(0.0, half, 0.0), down)

    add_mesh(
        world,
        cube,
        metal,
        Math.Vec3(-0.77, -0.866, -0.60),
        Math.Quat.angle_axis(Math.radians(20.0), Math.Vec3.up()),
        Math.Vec3(1.206, 2.268, 1.206)
    )
    add_mesh(
        world,
        cube,
        dielectric,
        Math.Vec3(0.77, -1.397, 0.58),
        Math.Quat.angle_axis(Math.radians(-20.0), Math.Vec3.up()),
        Math.Vec3(1.206)
    )

    world.spawn(ECS.EntityRecipe()
        ..with(Components.AmbientLight3D(
            color:Color.sky_500(),
            intensity:0.15
        ))
    )
    world.spawn(ECS.EntityRecipe()
        ..with(Components.Transform3D(position:Math.Vec3(0.0, 1.82, 0.0)))
        ..with(Components.PointLight3D(
            color:Color.bytes(255, 244, 214),
            intensity:2.2,
            radius:3.85
        )
            ..softness = 0.75
            ..falloff = 0.35
        )
    )
}

func main() {
    Application()
        ..add_resource(Resources.ToneMapping3D.aces(exposure:0.35))
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Scene3D — Cornell Box"
            ..width = 1280
            ..height = 720
        ))
        ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings()
            ..target = Math.Vec3(0.0, 0.0, 0.0)
            ..distance = 10.0
            ..min_distance = 5.0
            ..max_distance = 15.0
            ..pitch = Math.radians(0.0)
            ..vertical_fov = Math.radians(35.0)
            ..near_plane = 0.05
            ..far_plane = 80.0
        ))
        ..add_system(Application.Schedule.startup, create_box)
        ..run()
}
