use GFX.Application
use GFX.Assets.GLTF
use GFX.Components
use GFX.ECS
use GFX.Plugins
use GFX.Resources
use GFX.Scene3D
use STD.Math

func create_scene(
    world:&Resources.World,
    meshes:&Resources.Meshes3D,
    images:&Resources.Images
) {
    let model = GLTF.load("../Assets/Models/TestPBR.glb")
    let center = model.center()
    let radius = model.radius()
    let instance = Scene3D.instantiate(model, world, meshes, images)

    var sun = Components.SunLight3D()
        ..direction = Math.Vec3(-0.25, -0.75, 0.4).normalized()
        ..intensity = 4.0
        ..shadow_follows_camera = false
        ..shadow_center = center
        ..shadow_size = Math.Vec2(Math.max(radius * 2.2, 1.0))
        ..shadow_depth = Math.max(radius * 4.0, 2.0)
    world.spawn(ECS.EntityRecipe()..with(sun))
}

func main() {
    Application()
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "Scene3D — glTF PBR"
            ..width = 1100
            ..height = 720
        ))
        ..add_plugin(Plugins.Scene3D())
        ..add_plugin(Plugins.ViewportCamera3D(Plugins.ViewportCamera3D.Settings()
            ..target = Math.Vec3(0.0, 0.55, 0.0)
            ..distance = 8.0
            ..min_distance = 2.0
            ..max_distance = 12.0
            ..pitch = Math.radians(-35.0)
            ..vertical_fov = Math.radians(42.0)
            ..near_plane = 0.05
            ..far_plane = 80.0
        ))
        ..add_resource(Resources.Skybox3D.procedural(Scene3D.ProceduralSky.day()))
        ..add_resource(Resources.ToneMapping3D.aces(exposure:0.35))
        ..add_system(Application.Schedule.startup, create_scene)
        ..run()
}
