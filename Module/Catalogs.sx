use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Scene3D.FirstPersonCamera as FirstPerson
use GFX.Scene3D.ViewportCamera.ViewportCamera
use STD.Math

// The dimensional name belongs only to the flattened GFX.Plugins catalog.
public struct FirstPersonCamera3D:PluginProtocol {
    struct Settings {
        var position:Math.Vec3
        var yaw:float = 0.0
        var pitch:float = 0.0
        var move_speed:float = 5.0
        var sprint_multiplier:float = 2.0
        var look_sensitivity:float = 0.0025
        var min_pitch:float = -1.5009832
        var max_pitch:float = 1.5009832
        var vertical_fov:float = 1.0471976
        var near_plane:float = 0.05
        var far_plane:float = 500.0
        var order:int = 0
        var active:bool = true
        var capture_mouse:bool = true

        init() { self.position = Math.Vec3(0.0, 1.7, 5.0) }

        package func first_person() FirstPerson.Settings {
            return FirstPerson.Settings()
                ..position = self.position
                ..yaw = self.yaw
                ..pitch = self.pitch
                ..move_speed = self.move_speed
                ..sprint_multiplier = self.sprint_multiplier
                ..look_sensitivity = self.look_sensitivity
                ..min_pitch = self.min_pitch
                ..max_pitch = self.max_pitch
                ..vertical_fov = self.vertical_fov
                ..near_plane = self.near_plane
                ..far_plane = self.far_plane
                ..order = self.order
                ..active = self.active
                ..capture_mouse = self.capture_mouse
        }
    }

    private let viewport:ViewportCamera

    init(settings:FirstPersonCamera3D.Settings = FirstPersonCamera3D.Settings()) {
        self.viewport = ViewportCamera(settings.first_person())
    }

    func id() str { return self.viewport.id() }

    func build(application:&Application) {
        self.viewport.build(application)
    }
}
