use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Assets.Image
use GFX.ECS
use GFX.GPU
use GFX.Scene3D.CanvasPanel.CanvasPanel
use GFX.Scene3D.CanvasPanel.CanvasPanels
use GFX.Rendering
use GFX.Rendering.Renderer as RenderingRenderer
use GFX.Scene3D.Meshes
use GFX.Scene3D.Mesh
use GFX.Scene3D.Renderer
use GFX.Scene3D.Skybox.Skybox
use GFX.Scene3D.Sprite
use GFX.Scene3D.ToneMapping
use GFX.Scene3D.Transform
use GFX.Window

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.Scene3D.Plugin" }

    func build(host:&Application) {
        host.add_plugin(ECS.Plugin())
        if host.inherits_plugin(self.id()) {
            self.add_content_systems(host)
            return
        }
        host.extend_bundles(self)
        host.add_plugin(Rendering.Plugin())
        if !host.resources().has<Meshes>() { host.add_resource(Meshes()) }
        if !host.resources().has<Image.Store>() { host.add_resource(Image.Store()) }
        if !host.resources().has<Skybox>() {
            host.add_resource(Skybox.none())
        }
        if !host.resources().has<ToneMapping>() { host.add_resource(ToneMapping.aces()) }
        if !host.resources().has<CanvasPanels>() { host.add_resource(CanvasPanels()) }
        host.add_resource(Renderer())
        {
            var resources = host.resources()
            var rendering = resources.get_mut<Rendering.Renderer>()
            rendering.add_pass("GFX.Scene3D", render_scene, depth:true)
        }
        host.add_system(Schedule.startup, start_scene)
        if !host.has_plugin("GFX.Application.BundleManager") ||
            host.inherits_plugin("GFX.Application.BundleManager")
        {
            self.add_content_systems(host)
        }
        host.add_system(Schedule.shutdown, stop_scene)
    }

    private func add_content_systems(host:&Application) {
        host.add_system(Schedule.render, update_viewport)
        host.add_system(Schedule.render, update_skybox)
        host.add_system(Schedule.render, update_tone_mapping)
        host.add_system(Schedule.render, prepare_scene)
    }
}

func start_scene(
    device:@GPU.Device,
    surface:@GPU.Surface,
    rendering:@RenderingRenderer,
    renderer:&Renderer,
    meshes:&Meshes,
    panels:&CanvasPanels
) {
    renderer.start(device, surface, rendering.sample_count(), meshes)
    panels.bind(device)
}

func update_viewport(window:@Window, renderer:&Renderer) {
    renderer.set_viewport(window.pixel_size())
}

func update_tone_mapping(tone_mapping:@ToneMapping, renderer:&Renderer) {
    renderer.set_tone_mapping(tone_mapping)
}

func update_skybox(skybox:@Skybox, renderer:&Renderer) {
    renderer.set_skybox(skybox)
}

func prepare_scene(
    device:@GPU.Device,
    world:@ECS.World,
    query:ECS.Query<(ECS.Entity, @Transform, @Mesh)>,
    panel_query:ECS.Query<(ECS.Entity, @Transform, @CanvasPanel)>,
    sprite_query:ECS.Query<(@Transform, @Sprite)>,
    meshes:@Meshes,
    images:@Image.Store,
    renderer:&Renderer,
    panels:&CanvasPanels
) {
    renderer.begin_prepare(world)
    for (entity, transform, mesh) in query {
        renderer.collect(world, entity, transform, mesh, meshes)
    }
    for (entity, transform, panel) in panel_query {
        renderer.collect_panel(world, entity, transform, panel, panels)
    }
    for (transform, sprite) in sprite_query {
        renderer.collect_sprite(transform, sprite, images)
    }
    renderer.finish_prepare(device, meshes, images, panels)
}

func render_scene(pass:@GPU.RenderPass, application:@Application) {
    var renderer = application.resources().get<Renderer>()
    renderer.draw(pass)
}

func stop_scene(application:Application) {
    var panels = application.resources().remove<CanvasPanels>()
    assert(panels != null)
    var removed = application.resources().remove<Renderer>()
    assert(removed != null)
}
