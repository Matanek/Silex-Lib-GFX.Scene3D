public struct MeshHandle {
    module let asset_index:int
    module let asset_generation:int

    init() {
        self.asset_index = -1
        self.asset_generation = 0
    }

    module init(index:int, generation:int) {
        self.asset_index = index
        self.asset_generation = generation
    }

    func is_valid() bool {
        return self.asset_index >= 0 && self.asset_generation > 0
    }

    module func index() int { return self.asset_index }
    module func generation() int { return self.asset_generation }
}
